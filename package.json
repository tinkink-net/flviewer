{
  "name": "flviewer",
  "version": "1.0.0",
  "description": "Pure client-side file preview for the browser: images & PDF with built-in minimal UI.",
  "keywords": [
    "file-preview",
    "image",
    "pdf",
    "viewer",
    "web-component"
  ],
  "license": "MIT",
  "author": "tinkink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkink/flviewer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev",
    "test": "vp test",
    "check": "vp check",
    "build": "vp pack --dts",
    "prepublishOnly": "vp pack --dts --publint --attw"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "happy-dom": "^18.0.1",
    "knip": "^6.35.1",
    "playwright": "^1.55.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vite-plus": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
