{
  "name": "flviewer",
  "version": "0.1.0",
  "description": "Pure client-side file preview for the browser: images, PDF, video/audio, text family and office documents (DOCX/XLSX/PPTX) with built-in minimal UI.",
  "keywords": [
    "audio",
    "csv",
    "docx",
    "file-preview",
    "image",
    "markdown",
    "pdf",
    "pptx",
    "text",
    "video",
    "viewer",
    "web-component",
    "xlsx"
  ],
  "license": "MIT",
  "author": "tinkink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkink/flviewer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp dev",
    "test": "vp test",
    "check": "vp check",
    "build": "vp pack --dts",
    "prepublishOnly": "vp pack --dts --publint --attw"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "pdfjs-dist": "^5.4.149",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "happy-dom": "^18.0.1",
    "knip": "^6.35.1",
    "playwright": "^1.55.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vite-plus": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
